{
  "expo": {
    "name": "PlantUp",
    "slug": "PlantUp",
    "version": "1.0.0",
    "newArchEnabled": true,
    "scheme": "plantup",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1db954",
          "sounds": [
            "./assets/sounds/sprig_noti.wav",
            "./assets/sounds/advices_ping.mp3",
            "./assets/sounds/rec.wav",
            "./assets/sounds/critical_sprig.wav",
            "./assets/sounds/sprig_warning.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "react-native-compressor",
      "expo-asset",
      "./withJitpackNotifeeExclude.js"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abehari.PlantUp",
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000",
        "style": "light",
        "hidden": true
      }
    },
    "extra": {
      "eas": {
        "projectId": "12345678-1234-1234-1234-1234567890ab"
      }
    }
  }
}