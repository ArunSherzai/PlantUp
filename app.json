{
  "expo": {
    "name": "PlantUp",
    "slug": "PlantUp",
    "version": "1.0.0",
    "newArchEnabled": true,
    "scheme": "plantup",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "react-native-compressor",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "PlantUp needs camera access to take photos and videos for posts.",
          "microphonePermission": "PlantUp needs microphone access to record video with audio.",
          "recordAudioAndroid": {
            "audioEncoder": "aac",
            "outputFormat": "mpeg4"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.abehari.PlantUp",
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000",
        "style": "light",
        "hidden": true
      }
    }
  }
}